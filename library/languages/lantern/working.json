    "line": {
      "$type": "number",
      "body": {
        "$value": 1.6
      },
      "heading": {
        "$value": 1.2
      }
    },
    "breakpoint": {
      "$type": "dimension",
      "md": {
        "$value": "768px"
      },
      "lg": {
        "$value": "1200px"
      }
    }
  },
