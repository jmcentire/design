  "layout": {
    "variants": {
      "listing-card": {
        "editorial": {
          "template": "<article>{{slot:media}}<div data-kd-part=\"content\">{{slot:title}}{{slot:location}}{{slot:rating}}{{slot:price}}{{slot:action}}</div></article>"
        }
      }
    }
  },
  "components": {
    "page-shell": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}",
        "background-color": "{color.paper}"
      }
    },
    "nav": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}",
        "display": "flex",
        "flex-wrap": "wrap",
        "justify-content": "space-between",
        "align-items": "center"
      },
      "assets": {
        "logo": "lantern-mark:primary"
      },
      "slots": {
        "logo": {
          "properties": {
            "width": "{shape.logo}"
          }
        }
      }
    },
    "search-bar": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}",
        "display": "grid"
      },
      "slots": {
        "action": {
          "properties": {
            "color": "{color.card}",
            "background-color": "{color.primary}",
            "padding": "{space.md}",
            "border-radius": "{shape.radius}"
          }
        }
      }
    },
    "filter-group": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}"
      }
    },
    "listing-card": {
      "variant": "editorial",
      "properties": {
        "display": "flex",
        "flex-direction": "column",
        "padding": "{space.md}",
        "gap": "{space.md}",
        "background-color": "{color.card}",
        "border-color": "{color.border}",
        "border-width": "{shape.line}",
        "border-radius": "{shape.radius}"
      },
      "parts": {
        "content": {
          "display": "flex",
          "flex-direction": "column",
          "gap": "{space.xs}"
        }
      },
      "assets": {
        "media": "evening-stay:primary"
      }
    },
    "gallery": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}"
      },
      "assets": {
        "media": "evening-stay:primary"
      }
    },
    "detail-header": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}"
      }
    },
    "form": {
      "variant": "default",
      "properties": {
        "padding": "{space.lg}",
        "gap": "{space.md}",
        "display": "grid"
      },
      "slots": {
        "action": {
          "properties": {
