  "overrides": [
    {
      "scope": "listing-card@md",
      "properties": {
        "flex-direction": "row"
      },
      "reason": "Editorial card places media beside its text on wider screens."
    },
    {
      "scope": "listing-card.media@md",
      "properties": {
        "width": "{shape.media}"
      },
      "reason": "Reserve a compact image column beside editorial content."
    },
    {
      "scope": "page-shell.title@md",
      "properties": {
        "font-size": "{type.title-md}"
      },
      "reason": "The title scale grows to 34px at the medium breakpoint."
    },
    {
      "scope": "listing-card.title@md",
      "properties": {
        "font-size": "{type.title-md}"
      },
      "reason": "The title scale grows to 34px at the medium breakpoint."
    },
    {
      "scope": "detail-header.title@md",
      "properties": {
        "font-size": "{type.title-md}"
      },
      "reason": "The title scale grows to 34px at the medium breakpoint."
    },
    {
      "scope": "hero.title@md",
      "properties": {
        "font-size": "{type.title-md}"
      },
      "reason": "The title scale grows to 34px at the medium breakpoint."
    }
  ],
  "behaviors": [
    {
      "scope": "listing-card.title",
      "kind": "truncate",
      "lines": 2,
      "full-content": "listing.html",
      "reason": "Cards offer a two-line preview; full listing titles remain on the detail page."
    },
    {
      "scope": "gallery",
      "kind": "horizontal-scroll",
      "reason": "Browse the photo sequence horizontally while the page retains vertical reflow."
    }
  ],
